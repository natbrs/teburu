{
  "name": "teburu",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "cordova": "cordova run browser --no-open",
    "dev": "concurrently \"nodemon server.js\" \"cordova run browser --no-open\"",
    "cordova-sync": "concurrently \"nodemon server.js\" \"cordova run browser --no-open\" \"browser-sync start --proxy 'localhost:8000' --files 'platforms/browser/www/**/*' --port 3000 --open\""
  },
  "author": "natbrs",
  "license": "ISC",
  "cordova": {
    "plugins": {
      "cordova-plugin-android-permissions": {},
      "cordova-plugin-firebasex": {},
      "cordova-plugin-toast": {},
      "cordova-plugin-device": {}
    },
    "platforms": [
      "browser"
    ]
  },
  "dependencies": {
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-basic-auth": "^1.2.1",
    "firebase": "^11.0.2",
    "firebase-admin": "^13.2.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "nodemailer": "^6.10.0",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "browser-sync": "^3.0.3",
    "concurrently": "^7.6.0",
    "cordova-browser": "^7.0.0",
    "eslint": "^9.20.1",
    "nodemon": "^3.1.9"
  }
}
